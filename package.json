{
  "name": "@reyneill/bip",
  "version": "0.1.2",
  "packageManager": "bun@1.4.4",
  "description": "Experimental proof-carrying TypeScript package tooling.",
  "type": "module",
  "bin": {
    "bip": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "docs",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run deps:check && bun test && bun run check:self",
    "c": "bun run check",
    "typecheck": "bun check --no-script",
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "deps:check": "bun dedupe --check",
    "test": "bun test",
    "hooks": "sh scripts/install-git-hooks.sh",
    "pack:dry-run": "bun pm pack --dry-run",
    "publish:dry-run": "bun publish --dry-run --access public",
    "publish:public": "bun publish --access public",
    "release:patch": "bun run scripts/release.ts patch",
    "release:minor": "bun run scripts/release.ts minor",
    "verify:self": "bun run src/cli.ts verify",
    "check:self": "bun run src/cli.ts verify --check",
    "verify:core": "bun run src/cli.ts verify-core examples/basic-site.tscore.ts --out generated/tscore",
    "scan:self": "bun run src/cli.ts scan .",
    "scan:published": "bun node_modules/bip/src/cli.ts scan ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.4.4",
    "bip": "npm:@reyneill/bip@^0.1.0"
  }
}
