{
  "checker": "lean4",
  "toolchain": "leanprover/lean4:v4.32.0",
  "source": "examples/basic-site.tscore.ts",
  "proofFile": "proofs/BasicSiteCore.lean",
  "leanCheck": {
    "status": "checked",
    "detail": "Lean checked 1 proof file(s)."
  },
  "verifiedExports": [
    {
      "exportName": "siteRoutes",
      "model": "TSCoreConstant",
      "properties": [
        {
          "statement": "siteRoutes is non-empty",
          "theorem": "Bip.Generated.TSCore.siteRoutes_nonempty"
        },
        {
          "statement": "path is unique across siteRoutes",
          "theorem": "Bip.Generated.TSCore.siteRoutes_all_path_unique"
        },
        {
          "statement": "every siteRoutes path starts with \"/\"",
          "theorem": "Bip.Generated.TSCore.siteRoutes_all_path_starts_with"
        }
      ]
    },
    {
      "exportName": "writingHref",
      "model": "TSCoreFunction",
      "properties": [
        {
          "statement": "writingHref returns a string starting with \"/writing/\" for every input",
          "theorem": "Bip.Generated.TSCore.writingHref_returns_prefix"
        }
      ]
    },
    {
      "exportName": "publishTransition",
      "model": "TSCoreStateMachine",
      "properties": [
        {
          "statement": "actions that canPublishTransition blocks leave the publishTransition state unchanged",
          "theorem": "Bip.Generated.TSCore.publishTransition_blocked_keeps_state"
        },
        {
          "statement": "archived is terminal: every action keeps it",
          "theorem": "Bip.Generated.TSCore.publishTransition_archived_terminal"
        },
        {
          "statement": "published is reachable from draft",
          "theorem": "Bip.Generated.TSCore.publishTransition_published_reachable"
        },
        {
          "statement": "archived is reachable from draft",
          "theorem": "Bip.Generated.TSCore.publishTransition_archived_reachable"
        },
        {
          "statement": "no sequence of actions takes publishTransition from published to draft",
          "theorem": "Bip.Generated.TSCore.publishTransition_published_never_reaches_draft"
        }
      ]
    }
  ]
}
